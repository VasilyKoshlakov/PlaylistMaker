<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.search.ui.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_searchFragment_to_playerFragment"
            app:destination="@id/playerFragment" />

    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.settings.ui.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/mediaFragment"
        android:name="com.practicum.playlistmaker.media.ui.MediaFragment"
        android:label="MediaFragment"
        tools:layout="@layout/activity_media">

        <action
            android:id="@+id/action_mediaFragment_to_createPlaylistFragment"
            app:destination="@id/createPlaylistFragment" />

        <action
            android:id="@+id/action_mediaFragment_to_playlistInfoFragment"
            app:destination="@id/playlistInfoFragment" />

    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.practicum.playlistmaker.media.ui.FavoritesFragment"
        android:label="FavoritesFragment"
        tools:layout="@layout/fragment_favorites">

        <action
            android:id="@+id/action_favoritesFragment_to_playerFragment"
            app:destination="@id/playerFragment" />

    </fragment>

    <fragment
        android:id="@+id/createPlaylistFragment"
        android:name="com.practicum.playlistmaker.playlists.ui.CreatePlaylistFragment"
        android:label="CreatePlaylistFragment"
        tools:layout="@layout/fragment_create_playlist">

        <action
            android:id="@+id/action_createPlaylistFragment_to_mediaFragment"
            app:destination="@id/mediaFragment"
            app:popUpTo="@id/mediaFragment" />

    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.practicum.playlistmaker.player.ui.PlayerFragment"
        android:label="PlayerFragment"
        tools:layout="@layout/fragment_player_with_bottom_sheet">

        <action
            android:id="@+id/action_playerFragment_to_createPlaylistFragment"
            app:destination="@id/createPlaylistFragment" />

    </fragment>

    <fragment
        android:id="@+id/playlistInfoFragment"
        android:name="com.practicum.playlistmaker.playlists.ui.PlaylistInfoFragment"
        android:label="PlaylistInfoFragment"
        tools:layout="@layout/fragment_playlist_info">

        <action
            android:id="@+id/action_playlistInfoFragment_to_playerFragment"
            app:destination="@id/playerFragment" />

        <action
            android:id="@+id/action_playlistInfoFragment_to_editPlaylistFragment"
            app:destination="@id/editPlaylistFragment" />

    </fragment>

    <fragment
        android:id="@+id/editPlaylistFragment"
        android:name="com.practicum.playlistmaker.playlists.ui.EditPlaylistFragment"
        android:label="EditPlaylistFragment"
        tools:layout="@layout/fragment_create_playlist">

        <action
            android:id="@+id/action_editPlaylistFragment_to_playlistInfoFragment"
            app:destination="@id/playlistInfoFragment"
            app:popUpTo="@id/playlistInfoFragment" />

    </fragment>

</navigation>